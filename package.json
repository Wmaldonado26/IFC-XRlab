{
  "name": "ifc2frag",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch --max-old-space-size=16384 server/index.ts",
    "dev:all": "concurrently \"npm run server\" \"vite\"",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "deploy": "vite build && gh-pages -d dist",
    "convert": "node --max-old-space-size=16384 scripts/convert-ifc.js",
    "split": "node --max-old-space-size=16384 scripts/split-ifc.js",
    "admin:create": "tsx scripts/create-admin.ts",
    "postinstall": "node scripts/patch-dependencies.js"
  },
  "dependencies": {
    "@thatopen/components": "^3.1.0",
    "@thatopen/components-front": "^3.1.0",
    "@thatopen/fragments": "^3.1.0",
    "@thatopen/ui": "^3.1.0",
    "@thatopen/ui-obc": "^3.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "three": "^0.178.0",
    "vue": "^3.5.17",
    "web-ifc": "^0.0.69"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.32",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/tsconfig": "^0.7.0",
    "busboy": "^1.6.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "eslint": "^9.29.0",
    "eslint-plugin-oxlint": "~1.1.0",
    "eslint-plugin-vue": "~10.2.0",
    "express": "^5.2.1",
    "gh-pages": "^6.3.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vue-tsc": "^2.2.10"
  }
}
